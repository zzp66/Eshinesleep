<style>
  /* 严格作用域：只影响当前 section */
  #media-swiper-{{ section.id }} {
    padding: 50px 15px;
  }

  #media-swiper-{{ section.id }} .mws-root {
    position: relative;
  }

  /* ========== 一级 Tabs (主 Tab) ========== */
  #media-swiper-{{ section.id }} .mws-primary-thumbs {
    margin-bottom: 20px;
    text-align: center;
  }
  #media-swiper-{{ section.id }} .mws-primary-thumbs .swiper-slide {
    width: auto;
    cursor: pointer;
    padding: 10px 20px;
    border-radius: 8px;
    background: #f4f4f4;
    margin-right: 8px;
    transition: 0.18s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  #media-swiper-{{ section.id }} .mws-primary-thumbs .swiper-slide.swiper-slide-thumb-active {
    background: #e7600f;
    color: #fff;
    font-weight: 700;
  }

  /* ========== 子 Tabs 缩略（带图+标题） ========== */
  #media-swiper-{{ section.id }} .mws-subtabs-thumbs {
    margin-bottom: 12px;
  }
  #media-swiper-{{ section.id }} .mws-subtab-thumb {
    display: flex;
    gap: 12px;
    align-items: stretch;
    cursor: pointer;
    padding: 8px;
    border-radius: 8px;
    background: #fafafa;
    min-width: 260px; /* 可根据需求调整 */
    box-sizing: border-box;
  }
  /* 左侧图片容器 */
  #media-swiper-{{ section.id }} .mws-subtab-thumb .mws-thumb-img {
    width: 110px;
    min-width: 110px;
    height: 80px;
    overflow: hidden;
    border-radius: 6px;
    flex-shrink: 0;
  }
  #media-swiper-{{ section.id }} .mws-subtab-thumb .mws-thumb-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* 右侧标题（桌面为上下排列） */
  #media-swiper-{{ section.id }} .mws-subtab-thumb .mws-thumb-title {
    display: flex;
    flex-direction: column; /* 上下排列 */
    justify-content: center;
    align-items: flex-start;
    gap: 6px;
    line-height: 1.2;
    font-size: 14px;
    color: #111;
    word-break: break-word;
  }
  /* 激活态 */
  #media-swiper-{{ section.id }} .mws-subtabs-thumbs .swiper-slide.swiper-slide-thumb-active .mws-subtab-thumb {
    background: #222;
    color: #fff;
  }
  #media-swiper-{{ section.id }} .mws-subtabs-thumbs .swiper-slide.swiper-slide-thumb-active .mws-subtab-thumb .mws-thumb-title {
    color: #fff;
  }

  /* ========== 子 Tabs 大图（Gallery） ========== */
  #media-swiper-{{ section.id }} .mws-subtabs-gallery .swiper-slide img {
    width: 100%;
    display: block;
    border-radius: 8px;
    object-fit: cover;
  }

  /* 显示当前组，其它组隐藏 */
  #media-swiper-{{ section.id }} .mws-subtabs-group {
    display: none;
  }
  #media-swiper-{{ section.id }} .mws-subtabs-group.active {
    display: block;
  }

  /* ========== 响应式：小于 768px 时的规则 ========== */
  @media screen and (max-width: 767px) {
    /* 一级 tabs 横向靠左 */
    #media-swiper-{{ section.id }} .mws-primary-thumbs .swiper-wrapper {
      justify-content: flex-start;
    }

    /* 子 tab 缩略变更：图片仍在左，标题在右但为一行并限制溢出 */
    #media-swiper-{{ section.id }} .mws-subtab-thumb {
      min-width: 200px;
      padding: 8px;
    }
    #media-swiper-{{ section.id }} .mws-subtab-thumb .mws-thumb-img {
      width: 80px;
      min-width: 80px;
      height: 60px;
    }
    #media-swiper-{{ section.id }} .mws-subtab-thumb .mws-thumb-title {
      flex-direction: row; /* 一行排列 */
      align-items: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #media-swiper-{{ section.id }} .mws-subtab-thumb .mws-thumb-title span {
      display: inline-block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* sub gallery 图片高度可适配 */
    #media-swiper-{{ section.id }} .mws-subtabs-gallery .swiper-slide img {
      height: auto;
    }
  }
</style>

<div class="section section-{{ section.id }} media-with-swiper" id="media-swiper-{{ section.id }}">
  <div class="page-width mws-root">
    <!-- 一级 Tabs -->
    <div class="swiper mws-primary-thumbs">
      <div class="swiper-wrapper">
        {% for item in section.blocks %}
          <div class="swiper-slide mws-primary-item" data-index="{{ forloop.index0 }}">
            {{ item.settings.item_text }}
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- 对应每个主 Tab 的子 Tab 组与 Gallery -->
    <div class="mws-subtabs-container">
      {% for item in section.blocks %}
        <div class="mws-subtabs-group" data-parent-index="{{ forloop.index0 }}">
          <!-- 子 Tab 缩略（图片左 文案右） -->
          <div class="swiper mws-subtabs-thumbs">
            <div class="swiper-wrapper">
              {% for i in (1..5) %}
                {% assign pc_key = "sub_img_" | append: i %}
                {% assign mb_key = "sub_img_mb_" | append: i %}
                {% assign text_key = "sub_text_" | append: i %}
                {% assign sub_img_pc = item.settings[pc_key] %}
                {% assign sub_img_mb = item.settings[mb_key] %}
                {% assign sub_text = item.settings[text_key] %}
                {% if sub_img_pc != blank or sub_img_mb != blank %}
                  <div class="swiper-slide mws-subtab-slide">
                    <div class="mws-subtab-thumb" data-sub-index="{{ forloop.index0 }}">
                      <div class="mws-thumb-img">
                        <picture>
                          {% comment %}
                            移动端显示优先使用 sub_img_mb，若未配置则回退到 sub_img_pc
                          {% endcomment %}
                          {% if sub_img_mb != blank %}
                            <source media="(max-width: 767px)" srcset="{{ sub_img_mb | image_url: width: 800 }}">
                          {% else %}
                            <source media="(max-width: 767px)" srcset="{{ sub_img_pc | image_url: width: 800 }}">
                          {% endif %}
                          {% if sub_img_pc != blank %}
                            <source media="(min-width: 768px)" srcset="{{ sub_img_pc | image_url: width: 1600 }}">
                          {% endif %}
                          <!-- fallback -->
                          <img src="{{ sub_img_pc | default: sub_img_mb | image_url: width: 1200 }}" alt="{{ sub_text | escape }}">
                        </picture>
                      </div>
                      <div class="mws-thumb-title">
                        <span>{{ sub_text }}</span>
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <!-- 子 Tab 的大图 Gallery（点击缩略会同步到这） -->
          <div class="swiper mws-subtabs-gallery">
            <div class="swiper-wrapper">
              {% for i in (1..5) %}
                {% assign pc_key = "sub_img_" | append: i %}
                {% assign mb_key = "sub_img_mb_" | append: i %}
                {% assign sub_img_pc = item.settings[pc_key] %}
                {% assign sub_img_mb = item.settings[mb_key] %}
                {% if sub_img_pc != blank or sub_img_mb != blank %}
                  <div class="swiper-slide">
                    <picture>
                      {% if sub_img_mb != blank %}
                        <source media="(max-width: 767px)" srcset="{{ sub_img_mb | image_url: width: 800 }}">
                      {% else %}
                        <source media="(max-width: 767px)" srcset="{{ sub_img_pc | image_url: width: 800 }}">
                      {% endif %}
                      {% if sub_img_pc != blank %}
                        <source media="(min-width: 768px)" srcset="{{ sub_img_pc | image_url: width: 1600 }}">
                      {% endif %}
                      <img src="{{ sub_img_pc | default: sub_img_mb | image_url: width: 1200 }}" alt="">
                    </picture>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (function () {
    // 使用 section id 严格作用域
    var sectionId = '{{ section.id }}';
    var root = document.querySelector('#media-swiper-' + sectionId);
    if (!root) return;

    // 一级 Tabs
    var primaryThumbsEl = root.querySelector('.mws-primary-thumbs');
    var primarySwiper = new Swiper(primaryThumbsEl, {
      slidesPerView: 'auto',
      spaceBetween: 10,
      centeredSlides: false,
      slideToClickedSlide: true
    });

    // 找到所有子组
    var groups = Array.prototype.slice.call(root.querySelectorAll('.mws-subtabs-group'));

    // 为每个组初始化 pair of Swipers (thumbs + gallery)
    var groupSwipers = groups.map(function (groupEl) {
      var thumbsEl = groupEl.querySelector('.mws-subtabs-thumbs');
      var galleryEl = groupEl.querySelector('.mws-subtabs-gallery');

      // 若没有缩略或 gallery，直接返回 null
      if (!thumbsEl || !galleryEl) return null;

      // 初始化子缩略 Swiper：使其可点击并作为 thumbs
      var thumbsSwiper = new Swiper(thumbsEl, {
        slidesPerView: 'auto',
        spaceBetween: 10,
        watchSlidesProgress: true,
        slideToClickedSlide: true
      });

      // 初始化gallery，并关联 thumbs
      var gallerySwiper = new Swiper(galleryEl, {
        slidesPerView: 1,
        spaceBetween: 10,
        thumbs: { swiper: thumbsSwiper },
      });

      return {
        groupEl: groupEl,
        thumbs: thumbsSwiper,
        gallery: gallerySwiper
      };
    });

    // 切换显示某个主 Tab 对应的子组
    function switchGroup(index) {
      groups.forEach(function (g, i) {
        if (i === index) {
          g.classList.add('active');
          // 更新 swiper（必要时）以确保尺寸正确
          var sw = groupSwipers[i];
          if (sw && sw.thumbs) {
            sw.thumbs.update();
            sw.gallery.update();
          }
        } else {
          g.classList.remove('active');
        }
      });
    }

    // 点击一级 tab 切换
    primarySwiper.on('click', function (swiper) {
      if (typeof swiper.clickedIndex !== 'undefined' && swiper.clickedIndex !== null) {
        switchGroup(swiper.clickedIndex);
      }
    });

    // 点击主 swiper 的 slideToClickedSlide 也会触发 slide change — 保证默认显示第一个
    // 默认显示第一个 group（若存在）
    switchGroup(0);

    // 可选：当窗口尺寸变化时，更新当前激活组的 swipers（防止图片尺寸/计算问题）
    window.addEventListener('resize', function () {
      var activeIdx = groups.findIndex(function (g) { return g.classList.contains('active'); });
      if (activeIdx === -1) return;
      var sw = groupSwipers[activeIdx];
      if (sw && sw.thumbs) {
        sw.thumbs.update();
        sw.gallery.update();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Media With Nested Swiper",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "主Tab",
      "settings": [
        {
          "type": "text",
          "id": "item_text",
          "label": "主 Tab 标题"
        },
        {
          "type": "header",
          "content": "子Tab内容（最多5个）"
        },

        { "type": "text", "id": "sub_text_1", "label": "子 Tab 1 文案" },
        { "type": "image_picker", "id": "sub_img_1", "label": "子 Tab 1 图片（PC）" },
        { "type": "image_picker", "id": "sub_img_mb_1", "label": "子 Tab 1 图片（Mobile，可选）" },

        { "type": "text", "id": "sub_text_2", "label": "子 Tab 2 文案" },
        { "type": "image_picker", "id": "sub_img_2", "label": "子 Tab 2 图片（PC）" },
        { "type": "image_picker", "id": "sub_img_mb_2", "label": "子 Tab 2 图片（Mobile，可选）" },

        { "type": "text", "id": "sub_text_3", "label": "子 Tab 3 文案" },
        { "type": "image_picker", "id": "sub_img_3", "label": "子 Tab 3 图片（PC）" },
        { "type": "image_picker", "id": "sub_img_mb_3", "label": "子 Tab 3 图片（Mobile，可选）" },

        { "type": "text", "id": "sub_text_4", "label": "子 Tab 4 文案" },
        { "type": "image_picker", "id": "sub_img_4", "label": "子 Tab 4 图片（PC）" },
        { "type": "image_picker", "id": "sub_img_mb_4", "label": "子 Tab 4 图片（Mobile，可选）" },

        { "type": "text", "id": "sub_text_5", "label": "子 Tab 5 文案" },
        { "type": "image_picker", "id": "sub_img_5", "label": "子 Tab 5 图片（PC）" },
        { "type": "image_picker", "id": "sub_img_mb_5", "label": "子 Tab 5 图片（Mobile，可选）" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media With Nested Swiper",
      "category": "Media"
    }
  ]
}
{% endschema %}
