{% style %}
  .section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}
<div class="section section-{{ section.id }} section--padding section-theme">
  <div class="section__container page-width page-width--{{ section.settings.container }}">
    <div class="section-theme-box">
      <div class="section-theme-title text-center">
        <h2 class="rich-text__heading inline-richtext h2">
          <motion-element
            data-motion="fade-up"
            data-motion-delay="50"
            class="block"
            style="visibility: visible; transform: translateY(0px); opacity: 1;"
            data-initialized="true"
          >
            {{ section.settings.coll_title }}
          </motion-element>
        </h2>
      </div>
      <div class="section-theme-content"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Section Theme",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "options": [
        {
          "value": "full",
          "label": "Full Width"
        },
        {
          "value": "fixed",
          "label": "Fixed Width"
        }
      ],
      "default": "fixed",
      "label": "Container"
    },
    {
      "type": "text",
      "id": "coll_title",
      "label": "Title",
      "default": "Section Theme"
    },
    {
      "type": "header",
      "content": "t:general.padding.section_heading.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "t:general.padding.top.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "t:general.padding.bottom.label",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Sertion Theme"
    }
  ]
}
{% endschema %}
