{% style %}
  .section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}
<style>
  .tab-with-faq p {
    margin: 0;
  }

  .faqs-wrapper {
    display: flex;
    gap: 40px;
    margin: 40px 0 0;
    overflow: hidden;
  }
  p.faqs-title-box-name {
    font-size: 22px;
    line-height: 26px;
    font-weight: 600;
    margin: 0 0 20px 0;
  }

  .faqs-title-box {
    width: 50%;
  }
  .faqs-content-box {
    width: 50%;
  }
  .faqs-title-content {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
  }
  .faq-tab-title-item {
    padding: 10px 20px;
    border-radius: 50px;
    border: 1px solid #d4d4d4;
    cursor: pointer;
    white-space: nowrap;
  }
  .faq-tab-title-item.active {
    background: #e7600f;
    color: #fff;
    font-weight: 600;
    border: 1px solid transparent;
  }

  .faq-tab-content-item {
    display: none;
  }
  .faq-item {
    border-top: 1px solid #ddd;
    padding: 20px 10px;
    cursor: pointer;
  }
  .faq-question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-question-icon {
    display: flex;
    transition: all 0.2s ease;
  }
  .faq-question-icon img {
    max-width: 16px;
  }
  .faq-item.active .faq-question-icon {
    transform: rotate(90deg);
  }
  .faq-tab-content-item.active {
    display: block;
  }
  .faq-answer {
    display: none;
    margin-top: 20px;
  }
  @media screen and (max-width: 767px) {
    p.faqs-title-box-name {
      font-size: 20px;
      line-height: 24px;
    }
    .faqs-wrapper {
      flex-wrap: wrap;
      gap: 25px;
      margin: 25px 0 0;
    }
    .faqs-title-box {
      width: 100%;
    }
    .faqs-content-box {
      width: 100%;
    }
    .faqs-title-content {
      overflow-x: scroll;
      flex-wrap: nowrap;
      padding: 10px;
    }
    .faq-answer {
      margin-top: 15px;
    }
  }
</style>
<div class="section section-{{ section.id }} section--padding tab-with-faq">
  <div class="section__container page-width page-width--{{ section.settings.container }}">
    <div class="tab-with-faq-box">
      <div class="text-center">
        <h2 class="rich-text__heading inline-richtext h2">
          <motion-element
            data-motion="fade-up"
            data-motion-delay="50"
            class="block"
            style="visibility: visible; transform: translateY(0px); opacity: 1;"
            data-initialized="true"
          >
            {{ section.settings.coll_title }}
          </motion-element>
        </h2>
      </div>
      <div class="faqs-wrapper">
        <div class="faqs-title-box">
          <p class="faqs-title-box-name">Filter By</p>
          <div class="faqs-title-content">
            {% for item in section.blocks %}
              <div class="faq-tab-title-item" data-tab="{{ forloop.index }}">{{ item.settings.tab_title }}</div>
            {% endfor %}
          </div>
        </div>
        <div class="faqs-content-box">
          {% for item in section.blocks %}
            <div class="faq-tab-content-item" data-tab="{{ forloop.index }}">
              {% for i in (1..5) %}
                {% assign q = 'question_' | append: i %}
                {% assign a = 'answer_' | append: i %}
                {% if item.settings[q] != blank %}
                  <div class="faq-item">
                    <div class="faq-question">
                      <p class="faq-question-text">{{ item.settings[q] }}</p>
                      <div class="faq-question-icon">
                        <img loading="lazy" data-avada-lazy
                          src="https://cdn.shopify.com/s/files/1/0768/5606/6378/files/icon_faq.png?v=1757526031"
                          alt=""
                        >
                      </div>
                    </div>
                    <div class="faq-answer">{{ item.settings[a] }}</div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
  $(function () {
    $('.faq-tab-title-item').removeClass('active');
    $('.faq-tab-content-item').removeClass('active');
    $('.faq-item').removeClass('active');
    $('.faq-answer').hide();

    var $firstTab = $('.faq-tab-title-item').first();
    if ($firstTab.length) {
      $firstTab.addClass('active');
      var firstTabId = $firstTab.data('tab');
      $('.faq-tab-content-item[data-tab="' + firstTabId + '"]').addClass('active');
    }

    $('.faq-tab-title-item').on('click', function () {
      var tabId = $(this).data('tab');

      $('.faq-tab-title-item').removeClass('active');
      $(this).addClass('active');

      $('.faq-tab-content-item').removeClass('active').find('.faq-answer').stop(true, true).hide();
      $('.faq-item').removeClass('active');

      $('.faq-tab-content-item[data-tab="' + tabId + '"]').addClass('active');
    });

    $(document).on('click', '.faq-item', function (e) {
      var $this = $(this);
      var $ans = $this.find('.faq-answer');

      if ($this.hasClass('active')) {
        $this.removeClass('active');
        $ans.stop(true, true).slideUp(200);
      } else {
        $this.siblings('.faq-item').removeClass('active').find('.faq-answer').stop(true, true).slideUp(200);
        $this.addClass('active');
        $ans.stop(true, true).slideDown(200);
      }
    });
  });
</script>

{% schema %}
{
  "name": "Tab With FAQ",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "options": [
        {
          "value": "full",
          "label": "Full Width"
        },
        {
          "value": "fixed",
          "label": "Fixed Width"
        }
      ],
      "default": "fixed",
      "label": "Container"
    },
    {
      "type": "text",
      "id": "coll_title",
      "label": "Title",
      "default": "FAQs"
    },
    {
      "type": "header",
      "content": "t:general.padding.section_heading.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "t:general.padding.top.label",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "t:general.padding.bottom.label",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "faq_tab",
      "name": "FAQ Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title"
        },
        {
          "type": "text",
          "id": "question_1",
          "label": "Question 1"
        },
        {
          "type": "richtext",
          "id": "answer_1",
          "label": "Answer 1"
        },
        {
          "type": "text",
          "id": "question_2",
          "label": "Question 2"
        },
        {
          "type": "richtext",
          "id": "answer_2",
          "label": "Answer 2"
        },
        {
          "type": "text",
          "id": "question_3",
          "label": "Question 3"
        },
        {
          "type": "richtext",
          "id": "answer_3",
          "label": "Answer 3"
        },
        {
          "type": "text",
          "id": "question_4",
          "label": "Question 4"
        },
        {
          "type": "richtext",
          "id": "answer_4",
          "label": "Answer 4"
        },
        {
          "type": "text",
          "id": "question_5",
          "label": "Question 5"
        },
        {
          "type": "richtext",
          "id": "answer_5",
          "label": "Answer 5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tab With FAQ"
    }
  ]
}
{% endschema %}
