{% liquid
  assign header_layout = section.settings.header_layout
%}
{% style %}
  .section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --swiper-navigation-size: 3.2rem;
  }
{% endstyle %}
{{ 'collection-with-tab.css' | asset_url | stylesheet_tag }}
<div class="section section-{{ section.id }} section--padding collection-with-tab">
  <div class="section__container page-width page-width--{{ section.settings.container }}">
    <div class="collection-with-tab-box">
      <div class="tab-title-box">
        <div class="tab-title-content">
          {% for block in section.blocks %}
            <div class="tab-title-item {% if forloop.first %}active{% endif %}" data-tab="tab-{{ forloop.index }}">
              {{ block.settings.collection_title }}
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="tab-content-box">
        {% for block in section.blocks %}
          {% assign coll = block.settings.collection %}
          {% if coll != blank %}
            <div
              class="tab-content {% if forloop.first %}active{% endif %}"
              id="tab-{{ forloop.index }}"
            >
              <div class="tab-content-swiper-wrap relative">
                <div class="swiper tab-product-swiper">
                  <div class="swiper-wrapper">
                    {% for product in coll.products limit: 8 %}
                      <div class="swiper-slide tab-product-card">
                        {% render 'new-product-card', product: product %}
                      </div>
                    {% endfor %}
                  </div>
                </div>
                <div class="swiper-controls swiper-controls--nav-floating collection-with-tab__nav md:hidden">
                  <button
                    type="button"
                    class="swiper-button swiper-button--drop-shadow swiper-button-prev btn tab-swiper-prev"
                    name="previous"
                    aria-label="{{ 'general.slider.previous_slide' | t }}"
                  >
                    <span class="btn__text">{% render 'icon-caret-left', size: 'small' %}</span>
                  </button>
                  <button
                    type="button"
                    class="swiper-button swiper-button--drop-shadow swiper-button-next btn tab-swiper-next"
                    name="next"
                    aria-label="{{ 'general.slider.next_slide' | t }}"
                  >
                    <span class="btn__text">{% render 'icon-caret-right', size: 'small' %}</span>
                  </button>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('.section-{{ section.id }}.collection-with-tab');
    if (!section) return;

    const tabTitles = section.querySelectorAll('.tab-title-item');
    const tabContents = section.querySelectorAll('.tab-content');
    const swiperMap = new Map();

    section.querySelectorAll('.tab-content .tab-product-swiper').forEach((swiperEl) => {
      const tabContent = swiperEl.closest('.tab-content');
      const wrap = swiperEl.closest('.tab-content-swiper-wrap');
      if (!tabContent || !wrap) return;

      const swiper = new Swiper(swiperEl, {
        slidesPerView: 1.2,
        spaceBetween: 20,
        watchOverflow: true,
        observer: true,
        observeParents: true,
        navigation: {
          nextEl: wrap.querySelector('.tab-swiper-next'),
          prevEl: wrap.querySelector('.tab-swiper-prev'),
        },
        breakpoints: {
          768: {
            slidesPerView: 1.4,
            spaceBetween: 20,
          },
          1000: {
            slidesPerView: 3,
            spaceBetween: 20,
          },
          1440: {
            slidesPerView: 4,
            spaceBetween: 20,
          },
        },
      });

      swiperMap.set(tabContent.id, swiper);
    });

    tabTitles.forEach((title) => {
      title.addEventListener('click', () => {
        const target = title.getAttribute('data-tab');

        tabTitles.forEach((t) => t.classList.remove('active'));
        title.classList.add('active');

        tabContents.forEach((content) => {
          content.classList.remove('active');
          if (content.id === target) {
            content.classList.add('active');
            const swiper = swiperMap.get(target);
            if (swiper) {
              requestAnimationFrame(() => swiper.update());
            }
          }
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Collection With Tab",
  "settings": [
    {
      "type": "header",
      "content": "t:general.general.name"
    },
    {
      "type": "select",
      "id": "container",
      "options": [
        {
          "value": "full",
          "label": "t:general.container.options__full.label"
        },
        {
          "value": "fixed",
          "label": "t:general.container.options__fixed.label"
        }
      ],
      "default": "fixed",
      "label": "t:general.container.label"
    },
    {
      "type": "header",
      "content": "t:general.padding.section_heading.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "t:general.padding.top.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "t:general.padding.bottom.label",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "collection_title",
          "label": "Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection With Tab"
    }
  ]
}
{% endschema %}
