<div class="new-product-card">
  <div class="new-product-img">
    <img loading="lazy" data-avada-lazy src="{{ product.featured_image | image_url: width: master }}" alt="">
  </div>
  <div class="new-product-infos">
    <div class="product-title-box">
      <p class="new-product-card-title">{{ product.title }}</p>
    </div>
    <div class="product-parameter-bar-box">
      {% assign total = 5 %}
      <div class="product-parameter-bar">
        {% for param in product.metafields.custom.parameter_bar.value %}
          <div class="rating-row {{ param.label | downcase }}">
            <span class="rating-label">{{ param.label }}</span>
            <div class="rating-bars">
              {% for i in (1..total) %}
                <span
                  class="bar {% if i <= param.value %}filled{% endif %}"
                  {% if i <= param.value and param.color %}
                    style="background-color: {{ param.color }};"
                  {% endif %}
                ></span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="product-briefinfo-box">
      {% for briefinfo in product.metafields.custom.brief_infos.value %}
        <div class="briefinfo-item">
          <img loading="lazy" data-avada-lazy src="https://cdn.shopify.com/s/files/1/0587/4139/1417/files/right.png?v=1757394754" alt="">
          <p class="briefinfo">{{ briefinfo }}</p>
        </div>
      {% endfor %}
    </div>
    <div class="product-priceinfo-box">
      <div class="product-compare-price">
        <p class="compare-price-compare">Starting From {{ product.price | money }}</p>
        <p class="compare-price-price">{{ product.compare_at_price | money }}</p>
      </div>
      <div class="product-link-btn-box">
        <a class="btn btn--primary" href="{{ product.url }}">
          <span class="btn__text">Shop Now</span>
        </a>
      </div>
    </div>
    {% comment %}
      <div class="product-num-box">
        <p class="product-num">11"</p>
      </div>
    {% endcomment %}
  </div>
</div>
