<div class="new-header-card-badge">
  {% if product.metafields.custom.badges.value != blank %}
    <div class="product-badges">
      {% for badge in product.metafields.custom.badges.value %}
        <span class="badge" style="background-color: {{ badge.color }};">
          {{ badge.title }}
        </span>
      {% endfor %}
    </div>
  {% endif %}
</div>
<div class="new-header-card-item">
  <div class="card-item-img">
    <img src="{{ product.featured_image | image_url: width: master }}" alt="">
  </div>
  <div class="card-item-infos">
    <p class="infos-title">{{ product.title }}</p>
    <div class="product-parameter-bar-box">
      {% assign total = 5 %}
      <div class="product-parameter-bar">
        {% for param in product.metafields.custom.parameter_bar.value %}
          <div class="rating-row {{ param.label | downcase }}">
            <span class="rating-label">{{ param.label }}</span>
            <div class="rating-bars">
              {% for i in (1..total) %}
                <span
                  class="bar {% if i <= param.value %}filled{% endif %}"
                  {% if i <= param.value and param.color %}
                    style="background-color: {{ param.color }};"
                  {% endif %}
                ></span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    {% if product.metafields.custom.product_specs.value %}
      <div class="product-layers-height-box">
        {% for spec in product.metafields.custom.product_specs.value %}
          <div class="product-layers-info">
            {{ spec.spec_name }}: <span>{{ spec.spec_value }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
