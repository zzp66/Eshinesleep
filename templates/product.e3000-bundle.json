        "faq_dVzhJn": {
          "type": "faq",
          "settings": {
            "question": "I received the mattress, why didn't I receive the bed frame?",
            "answer": "<p>We are very sorry, but due to the fact that our bed frames and mattresses are shipped separately, arrival times will vary. Please be patient.</p>"
          }
        },
        "faq_enEP3d": {
          "type": "faq",
          "settings": {
            "question": "Do you offer In-Home Delivery and Setup?",
            "answer": "<p>Thank you very much for your interest in our products, but unfortunately we do not offer in-home installation service. We will be updating this service at a later date.</p>"
          }
        },
        "faq_WcWh9d": {
          "type": "faq",
          "settings": {
            "question": "Can I enjoy the warranty policy and risk-free return of the ESHINE products I purchased from amazon",
            "answer": "<p>Only users who place orders from the official website can enjoy the official website's return warranty service</p>"
          }
        },
        "faq_i43Xai": {
          "type": "faq",
          "settings": {
            "question": "What does my 30-day risk free return include?",
            "answer": "<p>We want you to be completely satisfied with your purchase. If for any reason the customer wishes to return an item, you may do so within 30 days of the delivery date. <br/>Errors in ordering, sizing issues, financing, cancellations/requests to cancel and changes in circumstances are not part of the sleep trial and will void your refund eligibility.</p>"
          }
        },
        "faq_98NbnC": {
          "type": "faq",
          "settings": {
            "question": "How soon can I sleep on the mattress after opening?",
            "answer": "<p>You can start snoozing right away! Once the sheets are on, you're ready to begin! Make sure your mattress is face up before you put the sheets on. Mattresses take 24-72 hours to expand to their maximum size.</p>"
          }
        },
        "faq_zbdbCW": {
          "type": "faq",
          "settings": {
            "question": "Can a Split King adjustable bed be controlled with one remote?",
            "answer": "<p>Yes, our Split King adjustable bed can be controlled with a single remote when both sides are connected using a sync cable. Please note that the sync cable is sold separately.</p>"
          }
        },
        "faq_mwQNkN": {
          "type": "faq",
          "settings": {
            "question": "Can ESHINE adjustable beds be used in zero clearance mode only?",
            "answer": "<p>Yes, our King-size adjustable bed supports a zero-clearance setup, allowing it to fit perfectly on platform or storage bed frames.</p>"
          }
        }
      },
